# =====================================================================
# CreatorVerse AI configuration TEMPLATE. Copy to .env and fill in.
# Placeholders only: real values go in .env (git-ignored), never here.
# =====================================================================

# --- Read by serve.ps1 / api/config.js and SENT TO THE BROWSER (safe to expose) ---
# Supabase > Project Settings > API: the project base URL (no /rest/v1/) and the anon/publishable key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Where the site is served (used in verification/reset redirects; must be in Supabase Redirect URLs)
APP_BASE_URL=http://localhost:5173

# --- Server only: used by serve.ps1 for the free AI proxy ---
# Optional. https://enter.pollinations.ai (higher AI rate limits)
POLLINATIONS_KEY=

# =====================================================================
# Payment/email secrets are NOT read from this file by the website.
# Set them as Supabase Edge Function secrets (see supabase/.env.functions.example and SETUP.md).
# =====================================================================
