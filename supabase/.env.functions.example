# Supabase Edge Function secrets (SERVER ONLY). Copy to supabase/.env.functions and run:
#   npx supabase secrets set --env-file supabase/.env.functions
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically
# by the Edge Functions runtime; do not set them here.

# Site URL(s) allowed to call the functions from a browser (comma-separated)
APP_BASE_URL=https://your-site.example.com
ALLOWED_ORIGINS=https://your-site.example.com,http://localhost:5173

# Razorpay > Account & Settings > API Keys (use rzp_test_... keys until you go live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay > Webhooks > the secret you typed when creating the webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Resend > API Keys; EMAIL_FROM must use a domain verified in Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=CreatorVerse AI <notifications@your-verified-domain.com>

# Resend > Webhooks > your endpoint's signing secret (starts with whsec_) - enables delivered/bounced tracking
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Optional: milliseconds between sends (Resend's default limit is ~2 requests/second)
EMAIL_SEND_SPACING_MS=600

# Random long string; also used as a header by the Database Webhook / cron job that calls email-dispatch
EMAIL_DISPATCH_SECRET=generate-a-long-random-string
